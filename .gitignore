# generated deliverables (regenerate via scripts) — keep the playbook only
output/*.json
# raw browser/API captures saved by hand while scouting — huge, hold other
# players' data, and are superseded by the computed snapshot in data/history/
output/*.network-response
.playwright-mcp/
__pycache__/
*.pyc
.DS_Store
# never commit secrets / session ids
*.session
.env
.venv/
.pytest_cache/
output/brief_*.html
# OCR scratch frames — tw_place.py rewrites output/_ocr.png and output/_rows.png
# on every single tesseract call, so tracking them is pure binary churn
output/_*.png
# per-round GAC crib sheet: the human-readable twin of the
# output/gac_r<N>_placed_<date>.json that output/*.json already ignores. Written by hand
# for one season+round, names the opponent's squads, and is dead once the round closes.
output/gac_r*_placement_sheet.txt
# transient live-session scratch. The file states its own contract: everything durable
# goes into memory/notes.md, and this only holds what is still in flight.
memory/session_state.md
# farmbot runtime
farmbot/halts/
farmbot/config.json
farmbot/STOP
farmbot/reports/

# Secrets. A bare `.env` line does not cover `.env.bak-*`, `.env.local` or
# `.env.production`; a rotation script.s timestamped backup was staged into a
# public repo through exactly that gap. Keep the rule in the repo rather than
# in a global ignore file, which is machine-local and protects neither a fresh
# clone nor CI nor the VPS copy.
.env.*

# Coverage artefacts. `.coverage` is a file and `htmlcov/` a directory,
# so both forms are needed; a bare `htmlcov` would not match the directory.
.coverage
.coverage.*
htmlcov/
